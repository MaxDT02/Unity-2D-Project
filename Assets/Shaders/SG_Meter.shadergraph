    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "MeterRing (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -454.66668701171877,
            "y": -63.99998092651367,
            "width": 214.00001525878907,
            "height": 215.99998474121095
        }
    },
    "m_Slots": [
        {
            "m_Id": "6fea54775c3e4c03a9d9626bf76891fb"
        },
        {
            "m_Id": "f4d975dc19644d81982da90f98d2f6fe"
        },
        {
            "m_Id": "4157f27120244eaf936e3d1294de970f"
        },
        {
            "m_Id": "5ca7ab58624446a18f716e0aa4de8a47"
        },
        {
            "m_Id": "4464c159ccc54a17ba2333490c430110"
        },
        {
            "m_Id": "c6f6a593c0264b8f9c04b3882a3eeac4"
        },
        {
            "m_Id": "ab8679b077864d94af51ca646df1a42a"
        },
        {
            "m_Id": "a71c55dfaa8440d39d905ec566d06dcd"
        },
        {
            "m_Id": "c70b533ae2594b66889c3235b0f18d9b"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MeterRing",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float px = floor(UV.x * ImageWidth) + 0.5 - ImageWidth * 0.5;\nfloat py = floor(UV.y * ImageHeight) + 0.5 - ImageHeight * 0.5;\nfloat ax = abs(px);\nalpha = step(ax, BarWidth * 0.5);\ninBox = step(ax, BoxWidth * 0.5) * step(abs(py), BoxHeight * 0.5);\nfloat centerHalf = ImageWidth * 0.25;\nfloat ringWidth = ImageWidth * 0.05;\nfloat fromCenter = (ax < centerHalf) ? 0.0 : min(5.0, 1.0 + floor((ax - centerHalf) / ringWidth));\nring = 5.0 - fromCenter;"
}

