    "m_Slots": [
        {
            "m_Id": "a261078a4f314947ab9ce37080d8c9bb"
        },
        {
            "m_Id": "e26ddb0f9ac34bfd8775ae133e570e3d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CoinSlot",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 c = pow(max(rgb, 0.0), 0.4545) * 255.0;\r\nslot = (c.r < 230.0) ? 6.0 : min(5.0, floor((c.b - 51.0) / 34.0));\r\nslot = max(slot, 0.0);"
}

